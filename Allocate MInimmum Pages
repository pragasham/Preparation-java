class Solution {
    public int findPages(int[] arr, int k) {
        // code here
        if(arr.length < k){
            return -1;
        }
        int low=max(arr);
        int high=sum(arr);
        while(low<=high){
            int mid=low+(high-low)/2;
            int count=fit(arr,mid);
            if(count>k){
                low= mid+1;
            }
            else{
                high=mid-1;
            }
            
        }
        return low;
    }
    public int sum(int[] arr){
        int ans=0;
        for(int i=0;i<arr.length;i++){
            ans+=arr[i];
        }
        return ans;
    }
    public int max(int [] arr){
        int min=Integer.MIN_VALUE;
        for(int i=0;i<arr.length;i++){
            if(min<arr[i]){
                min=arr[i];
            }
        }
        return min;
    }
    public int fit(int [] arr, int i){
        int page1=0;
        int stu=1;
        for(int j=0;j<arr.length;j++){
            if(page1+arr[j]<=i){
                page1+=arr[j];
            }
            else{
                stu++;
                page1=arr[j];
            }
        }
        return stu;
    }
    
}
